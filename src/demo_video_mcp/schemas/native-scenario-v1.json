{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-video://schemas/native-scenario/v1",
  "title": "Android Native Demo Video Scenario V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "platform",
    "app_artifact_id",
    "package_id",
    "device",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "const": "android"
    },
    "app_artifact_id": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "device": {
      "$ref": "#/$defs/device"
    },
    "reset_policy": {
      "enum": [
        "clean",
        "preserve"
      ],
      "default": "clean"
    },
    "max_duration_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 180,
      "default": 180
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "const": "emulator"
        },
        "avd": {
          "type": "string",
          "minLength": 1
        },
        "udid": {
          "type": "string",
          "minLength": 1
        },
        "device_name": {
          "type": "string",
          "minLength": 1
        },
        "platform_version": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ],
          "default": "portrait"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "value"
      ],
      "properties": {
        "by": {
          "enum": [
            "accessibility_id",
            "id",
            "text",
            "xpath",
            "class_name"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "nth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "launch",
            "wait_for",
            "tap",
            "fill",
            "press_key",
            "back",
            "swipe",
            "pause",
            "screenshot"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "value": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "key": {
          "enum": [
            "BACK",
            "ENTER",
            "HOME",
            "TAB"
          ]
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "percent": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "name": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "action",
        "effects",
        "approval",
        "retry_policy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "enum": [
            "none",
            "required"
          ]
        },
        "retry_policy": {
          "enum": [
            "safe",
            "never"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    }
  }
}
