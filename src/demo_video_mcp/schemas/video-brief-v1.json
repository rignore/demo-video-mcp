{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-video://schemas/brief/v1",
  "title": "Demo Video Brief V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "audience",
    "key_messages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "key_messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 900,
      "default": 60
    },
    "constraints": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "default": []
    }
  }
}
