{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-video://schemas/app-artifact/v1",
  "title": "Native App Artifact V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "platform",
    "format",
    "sha256",
    "size_bytes",
    "registered_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "platform": {
      "enum": [
        "android",
        "ios"
      ]
    },
    "format": {
      "enum": [
        "apk",
        "app_zip"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
