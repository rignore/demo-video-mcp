{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-video://schemas/plugin/v1",
  "title": "Demo Video Plugin V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "version",
    "allowed_origins",
    "plugin_actions",
    "guides",
    "scenario_templates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "allowed_origins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "plugin_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "string"
    },
    "guides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "scenario_templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "path",
        "required_variables"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "required_variables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
