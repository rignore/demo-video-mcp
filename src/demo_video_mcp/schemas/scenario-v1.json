{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-video://schemas/scenario/v1",
  "title": "Demo Video Scenario V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "start_url",
    "allowed_origins",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "start_url": {
      "type": "string",
      "format": "uri"
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "profile_id": {
      "type": "string"
    },
    "headed": {
      "type": "boolean",
      "default": false
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 1920,
          "default": 1920
        },
        "height": {
          "const": 1080,
          "default": 1080
        }
      }
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "captions": {
      "$ref": "#/$defs/captions"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision": {
          "enum": [
            "required",
            "not_required"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "default": "ko-KR"
        },
        "output": {
          "enum": [
            "sidecar",
            "burned_in",
            "both"
          ],
          "default": "both"
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen",
        "text"
      ],
      "properties": {
        "screen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "desktop",
            "mobile",
            "tablet"
          ]
        },
        "device": {
          "enum": [
            "desktop-chrome",
            "iphone-13",
            "pixel-7",
            "ipad-mini"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone_id": {
          "type": "string",
          "minLength": 1
        },
        "color_scheme": {
          "enum": [
            "light",
            "dark",
            "no-preference"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "by",
        "value"
      ],
      "properties": {
        "by": {
          "enum": [
            "role",
            "text",
            "label",
            "placeholder",
            "test_id",
            "css"
          ]
        },
        "value": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "exact": {
          "type": "boolean"
        },
        "regex": {
          "type": "boolean"
        },
        "nth": {
          "type": "integer",
          "minimum": 0
        },
        "has_text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "goto",
            "click",
            "fill",
            "press",
            "select_option",
            "scroll",
            "wait_for",
            "assert",
            "pause",
            "screenshot",
            "plugin"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "value": {
          "type": "string"
        },
        "top": {
          "type": "integer"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "operation": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "strict": {
          "type": "boolean"
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "visible",
            "hidden",
            "count",
            "url",
            "text"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "value": {},
        "regex": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "action",
        "effects",
        "approval",
        "retry_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caption": {
          "$ref": "#/$defs/caption"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "enum": [
            "none",
            "required"
          ]
        },
        "retry_policy": {
          "enum": [
            "safe",
            "never"
          ]
        },
        "completion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/completion"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    }
  }
}
